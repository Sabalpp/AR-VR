# Meta Care — environment configuration
# Copy to `.env` and fill in. Never commit the real .env.

# --- Gemini (Google GenAI) — required for AI triage & diagnosis ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides:
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview   # realtime exercise coach
# GEMINI_LIVE_VOICE=Kore

# --- ElevenLabs — optional, for device speech-out (TTS) ---
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=Rachel
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- Portal server ---
# Comma-separated allowed CORS origins (only needed if the frontend is served
# from a different origin than the API). Defaults to the Vite dev server.
# METACARE_CORS_ORIGINS=https://portal.example.com

# Shared secret the headset must present to open the /ws/coach voice socket
# (?token=...). Strongly recommended anywhere but localhost: each coach session
# consumes your Gemini quota.
# METACARE_COACH_TOKEN=
