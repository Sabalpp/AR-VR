# Copy to .env. Change secrets before exposing the tunnel.
POSTGRES_USER=rehab
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=rehab
JWT_SECRET=replace-with-at-least-32-random-secret-characters
# Exact external HTTPS origin, no trailing slash. Same origin serves REST and WSS.
PUBLIC_ORIGIN=https://replace-me.your-tunnel-domain.example
ENVIRONMENT=development
# Override fictional accounts before exposing the demo publicly.
DEMO_PASSWORD=replace-with-a-private-demo-password
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PRESAGE_ENABLED=false
